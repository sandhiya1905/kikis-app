{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Monitors API source code changes across the Nova Learn platform and automatically runs Postman collection tests to validate functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "services/*/src/**/*.js",
      "services/*/package.json",
      "api-gateway/*.js",
      "api-gateway/package.json",
      "web/*.js",
      "web/package.json",
      "shared/**/*.js",
      "postman/**/*.json",
      "docker-compose.yml",
      ".env",
      "*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code or configuration has been modified in the Nova Learn platform. Please retrieve the contents of the .postman.json file. If the file does not exist or is empty, create a Postman collection for the Nova Learn API. If it exists, get the collection ID and run the collection, showing me the results and propose fixes for any errors found."
  }
}