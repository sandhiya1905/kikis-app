# MongoDB Configuration
MONGODB_URI=mongodb://admin:password123@localhost:27017/nova_learn?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Service URLs (for development)
AUTH_SERVICE_URL=http://localhost:3001
CONTENT_SERVICE_URL=http://localhost:3002
SCHOLARSHIP_SERVICE_URL=http://localhost:3003
INTERVIEW_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:5000

# API Gateway
API_GATEWAY_PORT=3000

# Service Ports
AUTH_SERVICE_PORT=3001
CONTENT_SERVICE_PORT=3002
SCHOLARSHIP_SERVICE_PORT=3003
INTERVIEW_SERVICE_PORT=3004
AI_SERVICE_PORT=5000

# Environment
NODE_ENV=development
FLASK_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,mp4,avi,mov

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100